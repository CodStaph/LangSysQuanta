#!/usr/bin/env python3
"""req-registry: verify spec/REQ-registry.md against its sources (G1-03).

Checks (SDD-Plus §4.3: "CI 校验表内条目与规格实际条款一致")
  1. §1 AC rows <-> unique diagnostic codes in spec/diagnostics.md §1 +
     spec/bls.md tables (bijection, both directions)
  2. §2 UB rows <-> UB entries in spec/ub.md §1
  3. §3 R rows <-> R1-R8 rows in spec/feature-coverage.md §3
  4. §4 Q rows <-> the decision queue in 04 §3/§14.5 (skipped with INFO
     when the local-only draft is absent, e.g. on CI)
  5. §5 ADR rows <-> ADR definitions in 02 (defined + planned 21..27;
     skipped with INFO when 02 is absent)
  6. every filesystem path referenced in 正例/负例/承接任务 columns exists
     (paths matched by local-only .gitignore rules are INFO, not errors)
  7. every conformance reject `// EXPECT:` code is covered by a §1 row
  8. REQ ids unique and each falls in its section's number range
     (§1: 1-99, §2: 100-199, §3: 200-299, §4: 300-399, §5: 400-499)

Usage: python tools/req-registry --check   (exit 1 on any error)
"""

from __future__ import annotations

import fnmatch
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
REGISTRY = ROOT / "spec" / "REQ-registry.md"
DIAG = ROOT / "spec" / "diagnostics.md"
BLS = ROOT / "spec" / "bls.md"
UB = ROOT / "spec" / "ub.md"
FC = ROOT / "spec" / "feature-coverage.md"
D04 = ROOT / "04-S-1-执行计划.md"
D02 = ROOT / "02-架构评审与ADR.md"
GITIGNORE = ROOT / ".gitignore"

DIAG_DEF_RE = re.compile(r"^\|\s*`?([EW]-LS-[A-Z0-9]+(?:-[A-Z0-9]+)*)`?\s*\|", re.M)
UB_DEF_RE = re.compile(r"^\|\s*UB-(\d+)\s*\|", re.M)
R_DEF_RE = re.compile(r"^\|\s*R([1-8])\s", re.M)
Q_DEF_RE = re.compile(r"^\|\s*\*{0,2}Q(\d+)", re.M)
ADR_DEF_RE = re.compile(r"^###\s+ADR-(\d+)\b", re.M)
REQ_ROW_RE = re.compile(r"^\|\s*`?(REQ-\d+)`?\s*\|")
CODE_RE = re.compile(r"([EW]-LS-[A-Z0-9]+(?:-[A-Z0-9]+)*)")
FILE_RE = re.compile(r"[\w./\\-]+\.(?:ls|rs|md|c|lean|yml|sh|py|gbnf|ebnf)")
EXPECT_RE = re.compile(r"^//\s*EXPECT:\s*([EW]-LS-[A-Z0-9]+(?:-[A-Z0-9]+)*)")
PLANNED_ADR = frozenset(range(21, 28))
SECTION_RANGE = {1: (1, 99), 2: (100, 199), 3: (200, 299), 4: (300, 399), 5: (400, 499)}

errors: list[str] = []
infos: list[str] = []


def local_only(target: Path) -> bool:
    """True when the path is gitignored (local-only, never published)."""
    try:
        rel = target.resolve().relative_to(ROOT).as_posix()
    except ValueError:
        return False
    try:
        lines = GITIGNORE.read_text(encoding="utf-8").splitlines()
    except OSError:
        return False
    for line in lines:
        pat = line.strip()
        if not pat or pat.startswith("#") or pat.startswith("!"):
            continue
        pat = pat.lstrip("/").rstrip("/")
        if not pat:
            continue
        if fnmatch.fnmatch(rel, pat) or fnmatch.fnmatch(rel, pat + "/**"):
            return True
    return False


def section(text: str, start_pat: str) -> str:
    """Return the text between the heading matching start_pat and the next
    heading of the same or higher level."""
    lines = text.splitlines()
    start_re = re.compile(start_pat)
    begin = None
    level = 0
    for i, line in enumerate(lines):
        if start_re.match(line):
            begin = i
            level = len(line) - len(line.lstrip("#"))
            break
    if begin is None:
        return ""
    end = len(lines)
    for i in range(begin + 1, len(lines)):
        m = re.match(r"^(#{2,6})\s", lines[i])
        if m and len(m.group(1)) <= level:
            end = i
            break
    return "\n".join(lines[begin:end])


def parse_registry() -> dict[int, list[dict[str, str]]]:
    """{section_no: [row dict]} where each row has req + cells."""
    text = REGISTRY.read_text(encoding="utf-8")
    out: dict[int, list[dict[str, str]]] = {}
    cur = 0
    for line in text.splitlines():
        m = re.match(r"^##\s+(\d+)\.", line)
        if m:
            cur = int(m.group(1))
            out.setdefault(cur, [])
            continue
        if cur == 0 or not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        m2 = REQ_ROW_RE.match(line)
        if m2 and len(cells) >= 8:
            out.setdefault(cur, []).append({"req": m2.group(1), "cells": cells})
    return out


def check_01(rows: list[dict[str, str]]) -> tuple[int, set[str]]:
    published = set(DIAG_DEF_RE.findall(DIAG.read_text(encoding="utf-8")))
    published |= set(DIAG_DEF_RE.findall(BLS.read_text(encoding="utf-8")))
    registered: set[str] = set()
    for row in rows:
        for code in CODE_RE.findall(row["cells"][3]):
            registered.add(code)
    missing = published - registered
    extra = registered - published
    for c in sorted(missing):
        errors.append(f"§1: diagnostic code {c} in registries but no REQ row")
    for c in sorted(extra):
        errors.append(f"§1: REQ row references unknown diagnostic code {c}")
    return len(published), registered


def check_def_re(label: str, rows: list[dict[str, str]], src: Path,
                 pattern: re.Pattern, span: str, col: int = 1) -> int:
    """Generic: regex-collected ids in `src` vs ids in registry column."""
    text = src.read_text(encoding="utf-8") if src.exists() else ""
    have = set(pattern.findall(text))
    registered = set()
    for row in rows:
        for token_id in re.findall(r"\b(?:UB|R|Q|ADR)-?(\d+)\b", row["cells"][col]):
            registered.add(token_id)
    if not text:
        infos.append(f"{label}: source {src.name} not published; ID check skipped")
        return len(registered)
    missing = have - registered
    extra = registered - have
    for i in sorted(missing):
        errors.append(f"{label}: id {span}{i} defined in {src.name} but no REQ row")
    for i in sorted(extra, key=int):
        errors.append(f"{label}: REQ row references unknown {span}{i}")
    return len(have)


def main() -> int:
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

    if not REGISTRY.is_file():
        print("req-registry: FAIL: spec/REQ-registry.md missing", file=sys.stderr)
        return 1

    sections = parse_registry()
    # 8. REQ id uniqueness + section number range
    seen: dict[str, int] = {}
    for sec, rows in sections.items():
        lo, hi = SECTION_RANGE.get(sec, (0, 0))
        for row in rows:
            n = int(row["req"].split("-")[1])
            if row["req"] in seen:
                errors.append(f"duplicate REQ id {row['req']}")
            seen[row["req"]] = sec
            if not (lo <= n <= hi):
                errors.append(f"{row['req']} outside section {sec} range {lo}..{hi}")

    # 1. AC bijection
    n_codes, registered_codes = check_01(sections.get(1, []))

    # 2/3/4/5. source-set checks
    n_ub = check_def_re("§2 UB", sections.get(2, []), UB, UB_DEF_RE, "UB-", col=1)
    n_r = check_def_re("§3 R", sections.get(3, []), FC, R_DEF_RE, "R", col=1)
    n_q = check_def_re("§4 Q", sections.get(4, []), D04, Q_DEF_RE, "Q", col=1)
    n_adr_reg = len(sections.get(5, []))
    if D02.exists():
        defined = {int(n) for n in ADR_DEF_RE.findall(D02.read_text(encoding="utf-8"))}
        want = defined | PLANNED_ADR
        reg_ids = set()
        for row in sections.get(5, []):
            m = re.search(r"ADR-(\d+)", row["cells"][1])
            if m:
                reg_ids.add(int(m.group(1)))
        for i in sorted(want - reg_ids):
            errors.append(f"§5: ADR-{i} defined/planned in 02 but no REQ row")
        for i in sorted(reg_ids - want):
            errors.append(f"§5: REQ row references ADR-{i} not in 02")
        n_adr = len(want)
    else:
        infos.append("§5 ADR: source 02 not published; ID check skipped")
        n_adr = n_adr_reg

    # 6. referenced files exist
    files_checked = 0
    for rows in sections.values():
        for row in rows:
            for cell in row["cells"][4:7]:  # 正例/负例/承接任务
                for raw in FILE_RE.findall(cell):
                    p = ROOT / raw.replace("\\", "/")
                    files_checked += 1
                    if p.exists():
                        continue
                    if local_only(p):
                        infos.append(f"local-only reference: {raw}")
                    else:
                        errors.append(f"{row['req']}: referenced file missing: {raw}")

    # 7. reject corpus EXPECT codes covered by §1
    corpus_codes: set[str] = set()
    for sub in ("reject", "checker-spike/reject", "pending"):
        d = ROOT / "tests" / "conformance" / sub
        for f in sorted(d.glob("*.ls")):
            with f.open(encoding="utf-8") as fh:
                for line in fh:
                    m = EXPECT_RE.match(line.strip())
                    if m:
                        corpus_codes.add(m.group(1))
                        break
    for c in sorted(corpus_codes - registered_codes):
        errors.append(f"corpus code {c} (reject EXPECT) not covered by any §1 REQ row")

    # summary
    total = sum(len(v) for v in sections.values())
    print(
        f"req-registry: {total} rows "
        f"(§1={len(sections.get(1, []))}/§2={len(sections.get(2, []))}/"
        f"§3={len(sections.get(3, []))}/§4={len(sections.get(4, []))}/"
        f"§5={len(sections.get(5, []))}); "
        f"codes={n_codes} ub={n_ub} r={n_r} q={n_q} adr={n_adr}; "
        f"file-refs={files_checked}"
    )
    for e in errors:
        print(f"ERROR   {e}")
    for i in infos:
        print(f"INFO    {i}")
    if errors:
        print(f"req-registry: FAIL ({len(errors)} error(s))")
        return 1
    print("req-registry: PASS (registry in sync with sources)")
    return 0


if __name__ == "__main__":
    if "--check" not in sys.argv[1:]:
        print(__doc__)
        raise SystemExit(2)
    raise SystemExit(main())
