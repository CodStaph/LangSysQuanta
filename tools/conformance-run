#!/usr/bin/env python3
"""conformance-run: run tests/conformance/{accept,reject} with ls-sem.

This is the checker gate from 04 §14.6: every reject file must produce its
`// EXPECT:` code, and every accept file must produce no diagnostics.

L1 registration gates (SDD-Plus §8.4, machine-enforced since 2026-11-27):
  * `pending/*.ls` must be EMPTY (04 §14.6: "L1 executable" condition —
    pending corpus blocks L1; the checks below assert that claim);
  * the hand-maintained counts in tests/conformance/README.md «当前»
    must equal the actual glob surface (drift -> FAIL; the README is
    freeze-fenced, so editing it also trips tools/freeze-hash).
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LS_DIR = ROOT / "tools" / "ls-sem"
EXPECT_RE = re.compile(r"^//\s*EXPECT:\s*([EW]-LS-[A-Z0-9]+(?:-[A-Z0-9]+)*)")


def binary() -> Path:
    name = "ls-sem.exe" if os.name == "nt" else "ls-sem"
    return LS_DIR / "target" / "debug" / name


def run_check(path: Path) -> tuple[int, str]:
    proc = subprocess.run(
        [str(binary()), "check", str(path)],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")


def main() -> int:
    build = subprocess.run(
        ["cargo", "build", "--quiet", "--manifest-path", str(LS_DIR / "Cargo.toml")],
        capture_output=True,
        text=True,
    )
    if build.returncode != 0:
        print(build.stderr, file=sys.stderr)
        return build.returncode

    failures: list[str] = []
    accept = sorted((ROOT / "tests" / "conformance" / "accept").glob("*.ls"))
    reject = sorted((ROOT / "tests" / "conformance" / "reject").glob("*.ls"))
    cs_acc = sorted((ROOT / "tests" / "conformance" / "checker-spike" / "accept").glob("*.ls"))
    cs_rej = sorted((ROOT / "tests" / "conformance" / "checker-spike" / "reject").glob("*.ls"))
    pending = sorted((ROOT / "tests" / "conformance" / "pending").glob("*.ls"))

    # Gate 1 — 04 §14.6: pending corpus must stay empty (L1 condition).
    if pending:
        failures.append(
            "pending/ not empty: "
            + ", ".join(p.name for p in pending)
            + " (04 §14.6: pending corpus blocks L1; migrate or implement)"
        )

    # Gate 2 — SDD-Plus §8.4: README hand-maintained counts vs actual glob.
    readme = (ROOT / "tests" / "conformance" / "README.md").read_text(encoding="utf-8")
    patterns = {
        "accept": re.search(r"`accept/`：\s*(\d+)\s*条", readme),
        "reject": re.search(r"`reject/`：\s*(\d+)\s*条", readme),
        "pending": re.search(r"`pending/`：\*\*(\d+)\s*条\*\*", readme),
        "checker-spike": re.search(
            r"`checker-spike/`：\s*(\d+)\s*条 accept\s*\+\s*(\d+)\s*条 reject", readme
        ),
    }
    if any(m is None for m in patterns.values()):
        failures.append(
            "conformance README: count patterns not found in «当前» section "
            "(expected `accept/`：N 条 / `reject/`：N 条 / `pending/`：**N 条** / "
            "`checker-spike/`：N 条 accept + M 条 reject)"
        )
    else:
        counts = {
            "accept": (int(patterns["accept"].group(1)), len(accept)),
            "reject": (int(patterns["reject"].group(1)), len(reject)),
            "pending": (int(patterns["pending"].group(1)), len(pending)),
            "checker-spike accept": (int(patterns["checker-spike"].group(1)), len(cs_acc)),
            "checker-spike reject": (int(patterns["checker-spike"].group(2)), len(cs_rej)),
        }
        for name, (claimed, actual) in counts.items():
            if claimed != actual:
                failures.append(
                    f"README {name} count {claimed} != actual {actual} "
                    "(update tests/conformance/README.md «当前» and re-freeze)"
                )

    for path in accept:
        rc, out = run_check(path)
        if rc != 0:
            failures.append(f"accept {path.name}: expected rc=0, got rc={rc}")
            for line in out.splitlines():
                if "E-LS-" in line:
                    print(f"  {path.name}: {line}")
        else:
            print(f"PASS accept {path.name}")

    for path in reject:
        expected = None
        with path.open(encoding="utf-8") as f:
            for line in f:
                m = EXPECT_RE.match(line.strip())
                if m:
                    expected = m.group(1)
                    break
        if expected is None:
            failures.append(f"reject {path.name}: missing `// EXPECT:` on the first line")
            continue
        rc, out = run_check(path)
        if rc == 0:
            failures.append(f"reject {path.name}: expected rc=1, got rc=0")
            continue
        if f"{expected}:" not in out:
            failures.append(f"reject {path.name}: missing {expected}")
            continue
        print(f"PASS reject {path.name} ({expected})")

    if failures:
        print("\nFAILURES:")
        for f in failures:
            print(f"  {f}")
        print(f"SUMMARY FAIL ({len(failures)} failure(s))")
        return 1

    print(
        "SUMMARY PASS ("
        f"accept={len(accept)}, reject={len(reject)}, "
        f"checker-spike={len(cs_acc)}+{len(cs_rej)}, pending={len(pending)})"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
